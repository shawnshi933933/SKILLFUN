modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
COLD_WALLET_ADDRESS = "0xbb32AD3470290635a852EDc5F2895B75497cA368"
DEPLOYER_ADDRESS = "0xbb32AD3470290635a852EDc5F2895B75497cA368"
SKILLFUN_ORACLE_ADDRESS = "0x831a69d64eFB4BaE6BD47E2eDf8F92c3e1d9770e"
SKILLNFT_ADDRESS = "0x3030F26d3d61B43866a3c166d8f49A9C29A27c5A"
ZEROG_CHAIN_ID = "16661"
ZEROG_RPC_URL = "https://evmrpc.0g.ai"
SKILLFUN_VERIFIER_ADDRESS = "0x97F8f4a20d279B58Ebf8a13aB4cE856BbA8bb0f8"
ZEROG_AI_BASE_URL = "https://router-api.0g.ai"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20247
externalPort = 80

[[ports]]
localPort = 22013
externalPort = 3000
